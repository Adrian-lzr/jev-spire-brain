<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.adrianlzr</groupId>
    <artifactId>spirebrain-overlay</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>SpireBrain Overlay</name>
    <description>In-game window into the JEV brain: renders the decisions the
        external SpireBrain agent publishes, as a BaseMod top panel.</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Provided by the game install / ModTheSpire at runtime. -->
        <dependency>
            <groupId>com.megacrit</groupId>
            <artifactId>desktop</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${game.dir}/desktop-1.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.evacipated</groupId>
            <artifactId>BaseMod</artifactId>
            <version>5.0</version>
            <scope>system</scope>
            <systemPath>${basemod.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>com.kiooeht</groupId>
            <artifactId>ModTheSpire</artifactId>
            <version>3.0</version>
            <scope>system</scope>
            <systemPath>${modthespire.jar}</systemPath>
        </dependency>
        <!-- JSON parsing, shaded into the jar (tiny, permissive licence). -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>SpireBrainOverlay</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <artifactSet>
                                <includes><include>org.json:json</include></includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
