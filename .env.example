# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# --- real JEV via OpenRouter (the route this project uses) -------------------
# Endpoint: POST https://openrouter.ai/api/v1/systemone   model: jev-1.13
# Get a key at https://openrouter.ai/settings/keys
# Account caveat: your provider policy must allow `typesafe`, otherwise even JEV
# 404s with "no allowed providers are available for the selected model".
OPENROUTER_API_KEY=

# --- real JEV, other routes (only needed if you use them) -------------------
# TypeSafe direct: POST https://api.typesafe.ai/v1/systemone  (early access)
TYPESAFE_API_KEY=
# Cloudflare AI: model typesafe/jev
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- backend selection ------------------------------------------------------
# openrouter = real JEV (default here)  |  mock = offline deterministic
# llm        = structured-LLM baseline (NOT JEV)  |  official / cloudflare
JEV_BACKEND=openrouter
